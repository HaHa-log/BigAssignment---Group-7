<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.LoginPage.RegisterController"> <padding>
    <Insets bottom="20" left="20" right="20" top="20" />
</padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="CREATE ACCOUNT" />

    <TextField fx:id="nameField" promptText="Name" />
    <TextField fx:id="emailField" promptText="Email" />
    <PasswordField fx:id="passwordField" promptText="Password" />

    <Button onAction="#handleRegister" text="Register" /> <Label fx:id="messageLabel" textFill="red" />
   <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Already have an account?" />
   <Text accessibleRole="BUTTON" fill="#26306e" onMouseClicked="#goToLogin" strokeType="OUTSIDE" strokeWidth="0.0" text="Click here to login" />
</VBox>
