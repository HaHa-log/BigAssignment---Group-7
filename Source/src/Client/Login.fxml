<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Client.Controllers.LoginPage.LoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="ĐĂNG NHẬP" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <TextField fx:id="usernameField" promptText="Tên đăng nhập"/>
    <PasswordField fx:id="passwordField" promptText="Mật khẩu"/>
    <Button text="Đăng nhập" onAction="#handleLogin"/>
    <Label fx:id="messageLabel" textFill="red"/>
</VBox>