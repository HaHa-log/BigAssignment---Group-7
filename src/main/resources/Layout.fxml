<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane style="-fx-background-color: #37427c;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.LayoutController">
    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" style="-fx-background-color: #37427c;" BorderPane.alignment="CENTER">
            <children>
                <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#eaf9ff" height="40.0" stroke="BLACK" strokeType="INSIDE" width="40.0" />
                <Region HBox.hgrow="ALWAYS" />
                <Circle fx:id="profileShortcut" accessibleRole="BUTTON" fill="#eaf9ff" onMouseClicked="#redirectToProfile" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: #37427c;">
            <content>
                <AnchorPane style="-fx-background-color: #37427c;">
                    <children>
                        <StackPane fx:id="contentArea" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        </StackPane>
                    </children>
                </AnchorPane>
            </content>
        </ScrollPane>
    </center>
    <left><Region prefWidth="30.0" BorderPane.alignment="CENTER" /></left>
    <right><Region prefWidth="30.0" BorderPane.alignment="CENTER" /></right>
</BorderPane>