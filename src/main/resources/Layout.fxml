<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane styleClass="root-pane" stylesheets="style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.LayoutController">
    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="20" style="-fx-background-color: #37427c;" BorderPane.alignment="CENTER">

            <children>

                <!-- HOME -->
                <StackPane accessibleRole="BUTTON" onMouseClicked="#redirectToHomePage">
                    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#eaf9ff" height="40.0" stroke="BLACK" strokeType="INSIDE" width="40.0" />
                    <Label style="-fx-font-size: 18px;" text="🏠" />
                </StackPane>

                <Region HBox.hgrow="ALWAYS" />

                <!-- PROFILE -->
                <StackPane accessibleRole="BUTTON" onMouseClicked="#redirectToProfile">
                    <Circle fill="#eaf9ff" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                    <Label style="-fx-font-size: 18px;" text="👤" />
                </StackPane>

                <!-- REFRESH -->
                <StackPane accessibleRole="BUTTON" onMouseClicked="#refreshPage">
                    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#eaf9ff" height="40.0" stroke="BLACK" strokeType="INSIDE" width="40.0" />
                    <Label style="-fx-font-size: 16px;" text="🔄" />
                </StackPane>

            </children>

            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToHeight="false" fitToWidth="true" style="-fx-background-color: #37427c;">
            <content>
                  <StackPane fx:id="contentArea">
                        </StackPane>
            </content>
        </ScrollPane>
    </center>
    <left><Region prefWidth="30.0" BorderPane.alignment="CENTER" /></left>
    <right><Region prefWidth="30.0" BorderPane.alignment="CENTER" /></right>
   <bottom>
           <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <Button mnemonicParsing="false" text="🔨 Want to create your own Auction? Click here!" onMouseClicked="#toAuctionCreate"/>
               <!--<Label accessibleRole="BUTTON" onMouseClicked="#toAuctionCreate" style="-fx-background-color: linear-gradient(to right, #74b9ff, #a29bfe); -fx-background-radius: 25; -fx-padding: 7 7 7 7; -fx-font-size: 10px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔨 Want to create your own Auction? Click here!" textFill="WHITE" />-->
         <padding>
            <Insets bottom="10.0" top="20.0" />
         </padding>

           </HBox>
       </bottom>
</BorderPane>
