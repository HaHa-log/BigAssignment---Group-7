<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.LayoutController" stylesheets="style.css" styleClass="root-pane">
    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="20" style="-fx-background-color: #37427c;" BorderPane.alignment="CENTER">
            <children>
                <Rectangle fx:id="homePageShortcut" accessibleRole="BUTTON" arcHeight="5.0" arcWidth="5.0" fill="#eaf9ff" height="40.0" onMouseClicked="#redirectToHomePage" stroke="BLACK" strokeType="INSIDE" width="40.0" />
                <Region HBox.hgrow="ALWAYS" />
                <Circle fx:id="profileShortcut" accessibleRole="BUTTON" fill="#eaf9ff" onMouseClicked="#redirectToProfile" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                <Rectangle fx:id="refreshButton" accessibleRole="BUTTON" arcHeight="5.0" arcWidth="5.0" fill="#eaf9ff" height="40.0" layoutX="40.0" layoutY="20.0" onMouseClicked="#refreshPage" stroke="BLACK" strokeType="INSIDE" width="40.0" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: #37427c;">
            <content>
                  <StackPane fx:id="contentArea">
                        </StackPane>
            </content>
        </ScrollPane>
    </center>
    <left><Region prefWidth="30.0" BorderPane.alignment="CENTER" /></left>
    <right><Region prefWidth="30.0" BorderPane.alignment="CENTER" /></right>
   <bottom>
      <Label accessibleRole="BUTTON" onMouseClicked="#toAuctionCreate" text="Want to create your own Auction? Click here!" textAlignment="RIGHT" textFill="WHITE" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
