<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white;" stylesheets="@/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.AuctionPage.AuctionCreateController">
    <children>
        <HBox spacing="30.0" VBox.vgrow="SOMETIMES">
            <children>

                <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-border-color: #37427c;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="CREATE AUCTION">
                            <font>
                                <Font name="System Bold" size="36.0" />
                            </font>
                        </Label>
                  <VBox spacing="10.0">
                     <children>
                        <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="20.0">
                           <children>
                              <Line endX="100.0" startX="-100.0" />
                              <Label text="ITEM DETAILS">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Line endX="100.0" startX="-100.0" />
                           </children>
                        </HBox>
                        <VBox>
                           <children>
                                      <Text text="Item Name:" />
                                      <TextField fx:id="itemNameInput" maxHeight="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Text text="Description:" />
                              <TextField fx:id="descriptionInput" maxWidth="1.7976931348623157E308" prefHeight="200.0" />
                           </children>
                        </VBox>
                         <VBox>
                             <children>
                                 <Text text="Item Image:" />
                                 <HBox alignment="CENTER_LEFT" spacing="10.0">
                                     <Button onAction="#handleChooseImage" text="Choose Image" />
                                     <Label fx:id="fileNameLabel" text="No file selected" textFill="GRAY" />
                                 </HBox>
                                 <ImageView fx:id="imagePreview" preserveRatio="true" />
                             </children>
                         </VBox>
                     </children>
                  </VBox>
                  <VBox layoutX="21.0" layoutY="85.0" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="20.0">
                           <children>
                              <Line endX="100.0" startX="-100.0" />
                              <Label text="AUCTION DETAILS">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Line endX="100.0" startX="-100.0" />
                           </children>
                        </HBox>
                        <VBox>
                           <children>
                              <Label text="PRICING">
                                 <font>
                                    <Font name="System Italic" size="12.0" />
                                 </font>
                              </Label>
                              <VBox>
                                 <children>
                                    <Text text="Starting price:" />
                                    <TextField fx:id="startingPriceInput" maxWidth="1.7976931348623157E308" />
                                 </children>
                              </VBox>
                              <VBox />
                           </children>
                        </VBox>
                        <VBox layoutX="10.0" layoutY="40.0">
                           <children>
                              <Label text="TIME">
                                 <font>
                                    <Font name="System Italic" size="12.0" />
                                 </font>
                              </Label>
                              <HBox>
                                 <children>
                                    <VBox>
                                       <children>
                                          <Text text="Starting time:" />
                                          <DatePicker maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="200.0" />
                                       </children>
                                    </VBox>
                                     <Region HBox.hgrow="ALWAYS" />
                                    <VBox>
                                       <children>
                                          <Text text="Ending time:" />
                                          <DatePicker maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="200.0" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onMouseClicked="#createAuction" text="CREATE" />
                  <Label fx:id="auctionCreateResult" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" textAlignment="CENTER" />
                    </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
                </VBox>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
