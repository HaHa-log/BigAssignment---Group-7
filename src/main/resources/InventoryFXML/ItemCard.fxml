<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.Inventory.ItemCardController">
   <children>
      <StackPane prefHeight="150.0" prefWidth="200.0">
         <children>
            <ImageView fx:id="imageContainer" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>

            <VBox minWidth="150.0" spacing="5.0">
         <children>
            <Label fx:id="itemNameLabel" text="Item Name">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label fx:id="statusLabel" text="STATUS: " />
            <Label fx:id="startingPriceLabel" text="Starting price: $0.00" />
            <Label fx:id="currentPriceLabel" text="Current price: $0.00" />
         </children>
      </VBox>
   </children>
</HBox>
