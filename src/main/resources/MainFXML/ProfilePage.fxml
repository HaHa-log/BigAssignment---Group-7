<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.MainPage.ProfilePageController">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 12 20; -fx-background-color: #FFFFFF;">
            <Button onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #37427c; -fx-background-radius: 8; -fx-padding: 6 14; -fx-border-color: #37427c; -fx-border-radius: 5;" text="Logout" />
        </HBox>
    </top>

    <!-- LEFT -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="260" spacing="18" style="-fx-background-color: #2D3763; -fx-padding: 25; -fx-background-radius: 15;">

            <ImageView fitHeight="155.0" fitWidth="142.0" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10,0,0,4); -fx-background-radius: 100;">
            <image>

            </image></ImageView>
            <Label fx:id="usernameLabel" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Username" />

            <Label fx:id="roleLabel" style="-fx-text-fill: #A0AEC0; -fx-font-size: 16;" text="User role" />

            <Button onAction="#showEditProfile" style="-fx-background-color: #F2F2F2; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 18;" text="Edit Profile" />
        </VBox>
    </left>

    <!-- CENTER -->
    <center>
        <VBox spacing="25" style="-fx-padding: 25; -fx-background-color: #F8FAFC;">

            <!-- TAB BAR -->
            <HBox alignment="CENTER_LEFT" spacing="35">

                <Label fx:id="tabProfile" onMouseClicked="#showProfile" style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14; -fx-border-color: #1E3A8A; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 5 0; -fx-cursor: hand;" text="My Profile" />

                <Label fx:id="tabPassword" onMouseClicked="#showChangePassword" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="Change Password" />

                <Label fx:id="tabNotification" onMouseClicked="#showNotification" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="Notification" />

                <Label fx:id="tabHistory" onMouseClicked="#showHistory" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="History" />
            </HBox>

            <!-- CONTENT -->
            <StackPane fx:id="contentPane">
                <!-- PROFILE -->
                <VBox fx:id="profilePane" spacing="18" style="-fx-background-color: transparent; -fx-padding: 20 0 0 0 0; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">

                    <Label style="-fx-text-fill: #37427c; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20;" text="About Me" />

                    <Label fx:id="aboutLabel" style="-fx-text-fill: #2D3763; -fx-font-size: 14;" text="User info..." wrapText="true" />

                    <Label style="-fx-text-fill: #37427c; -fx-font-size: 16; -fx-font-weight: bold;" text="Contact" />

                    <VBox spacing="6">
                        <Label fx:id="phoneLabel" style="-fx-text-fill: #2D3763; -fx-font-size: 14;" text="Phone: ..." />
                        <Label fx:id="emailLabel" style="-fx-text-fill: #2D3763; -fx-font-size: 14;" text="Email: ..." />
                    </VBox>
                </VBox>

                <!-- EDIT -->
                <VBox fx:id="editPane" spacing="18" style="-fx-background-color: #020617; -fx-padding: 25; -fx-background-radius: 12;" visible="false">

                    <Label style="-fx-text-fill: #e2e8f0; -fx-font-size: 18; -fx-font-weight: bold;" text="Edit Profile" />

                    <Label style="-fx-text-fill: #cbd5f5;" text="About Me" />
                    <TextArea fx:id="aboutField" prefHeight="100" style="-fx-background-color: #0f172a; -fx-text-fill: black; -fx-background-radius: 8;" />

                    <Label style="-fx-text-fill: #cbd5f5;" text="Phone Number" />
                    <TextField fx:id="phoneField" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 8;" />

                    <Label style="-fx-text-fill: #cbd5f5;" text="Email" />
                    <TextField fx:id="emailField" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 8;" />

                    <HBox spacing="10">
                        <Button onAction="#handleSave" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 8;" text="Save" />
                        <Button onAction="#cancelEdit" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8;" text="Cancel" />
                    </HBox>
                </VBox>

                <!-- PASSWORD -->
                <VBox fx:id="passwordPane" spacing="12" style="-fx-background-color: #2D3763; -fx-padding: 25; -fx-background-radius: 12;" visible="false">

                    <Label style="-fx-text-fill: #e2e8f0; -fx-font-size: 16; -fx-font-weight: bold;" text="Change Password" />

                    <PasswordField fx:id="oldPasswordField" promptText="Current Password" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 8;" />
                    <PasswordField fx:id="newPasswordField" promptText="New Password" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 8;" />
                    <PasswordField fx:id="newPasswordConfirmField" promptText="Confirm Password" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 8;" />
               <Label fx:id="passwordChangeStatus" text="" />
               <Button mnemonicParsing="false" onAction="#handleChangePassword" style="-fx-background-color: green; -fx-text-fill: white;" text="Save" />
                </VBox>

                <!-- NOTIFICATION -->
                <VBox fx:id="notificationPane" style="-fx-background-color: #2D3763; -fx-padding: 25; -fx-background-radius: 12;" visible="false">
                    <Label style="-fx-text-fill: #e2e8f0; -fx-font-size: 16; -fx-font-weight: bold;" text="Notifications" />
                </VBox>

                <!-- HISTORY -->
                <VBox fx:id="historyPane" style="-fx-background-color: #2D3763; -fx-padding: 25; -fx-background-radius: 12;" visible="false">
                    <Label style="-fx-text-fill: #e2e8f0; -fx-font-size: 16; -fx-font-weight: bold;" text="History" />
                    <ListView fx:id="historyList" style="-fx-background-color: white; -fx-control-inner-background: white; -fx-text-fill: white;" />
                </VBox>

            </StackPane>
        </VBox>
    </center>

</BorderPane>
