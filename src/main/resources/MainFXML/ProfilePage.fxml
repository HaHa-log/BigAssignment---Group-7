    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.AuctionPage.AuctionDetailController">
        <children>
            <HBox spacing="30.0" VBox.vgrow="SOMETIMES">
                <children>
                    <StackPane minWidth="200.0" prefWidth="350.0" style="-fx-background-color: #37427c;" HBox.hgrow="ALWAYS">
                        <children>
                            <ImageView fitHeight="250.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true" />
                        </children>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </padding>
                    </StackPane>

                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Item Name">
                                <font>
                                    <Font name="System Bold" size="36.0" />
                                </font>
                            </Text>
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Starting Price: $0.00" />
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Current Price: $0.00" />

                                        <StackPane maxWidth="1.7976931348623157E308" minHeight="50.0" style="-fx-border-color: #37427c;" VBox.vgrow="ALWAYS" />

                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Text text="Place your bid:" />
                                    <TextField fx:id="bidAmountInput" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </HBox>

                        <TextArea text="Lorem ipsum..." wrapText="true" VBox.vgrow="ALWAYS" />
        </children>
        <padding>
            <Insets left="20.0" right="20.0" top="20.0" />
        </padding>
    </VBox>
