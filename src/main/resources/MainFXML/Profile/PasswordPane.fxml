<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Client.Controllers.MainPage.ProfilePage.PasswordController"
      fx:id="passwordPane"
      spacing="12"
      stylesheets="@profile.css"
      styleClass="background-card">

        <Label style="-fx-font-size: 24;-fx-font-weight: bold;-fx-text-fill: #1e293b;" text=" 🔒Change Password" />

        <PasswordField fx:id="oldPasswordField" promptText="Current Password" />
        <PasswordField fx:id="newPasswordField" promptText="New Password" />
        <PasswordField fx:id="newPasswordConfirmField" promptText="Confirm Password" />
        <Label fx:id="passwordChangeStatus" text="" />
        <Button mnemonicParsing="false" onAction="#handleChangePassword"
                text=" ✔ Save"
                stylesheets="@profile.css"
                styleClass="green-button"/>
    </VBox>

