<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: #0f172a; -fx-font-family: 'Segoe UI';" stylesheets="@profile.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.MainPage.ProfilePageController">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 12 20; -fx-background-color: #FFFFFF; -fx-border-color: #2D3763;">
            <Button onAction="#handleLogout" style="-fx-background-color: #2D3763; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 6 14; -fx-border-color: #37427c; -fx-border-radius: 5;" text="Logout" />
        </HBox>
    </top>

    <!-- LEFT -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="260" spacing="18" style="-fx-background-color: #2D3763; -fx-padding: 25; -fx-background-radius: 15;">

            <ImageView fitHeight="155.0" fitWidth="142.0" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10,0,0,4); -fx-background-radius: 100;">
                <image>

                </image></ImageView>
            <Label fx:id="usernameLabel" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Username" />

            <Label fx:id="roleLabel" style="-fx-text-fill: #A0AEC0; -fx-font-size: 16;" text="User role" />

            <Button onAction="#showEditProfile" styleClass="edit-btn" text="Edit Profile" />
        </VBox>
    </left>

    <!-- CENTER -->
    <center>
        <VBox spacing="25" style="-fx-padding: 25; -fx-background-color: #F8FAFC;">

            <!-- TAB BAR -->
            <HBox alignment="CENTER_LEFT" spacing="35">

                <Label fx:id="tabProfile" onMouseClicked="#showProfile" style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14; -fx-border-color: #1E3A8A; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 5 0; -fx-cursor: hand;" text="My Profile" />

                <Label fx:id="tabPassword" onMouseClicked="#showChangePassword" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="Change Password" />

                <Label fx:id="tabFinance" onMouseClicked="#showFinance" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="Finance" />

                <Label fx:id="tabNotification" onMouseClicked="#showNotification" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="Notification" />

                <Label fx:id="tabHistory" onMouseClicked="#showHistory" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-cursor: hand;" text="History" />
            </HBox>

            <!-- CONTENT -->
            <StackPane fx:id="contentPane">
                <!-- EDIT -->

                <!-- PASSWORD -->

                <!-- FINANCE -->

                <!-- NOTIFICATION -->

                <!-- HISTORY -->

            </StackPane>
        </VBox>
    </center>

</BorderPane>
