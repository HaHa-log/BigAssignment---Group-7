<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


    <VBox xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="Client.Controllers.MainPage.ProfilePage.ProfileController"
          fx:id="profilePane" spacing="18" style="-fx-background-color: transparent; -fx-padding: 20 0 0 0 0; -fx-background-radius: 12; -fx-border-color: #2D3763; -fx-border-width: 1 0 0 0;">

        <Label style="-fx-text-fill: #37427c; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-radius: 20;" text="About Me" />

        <Label fx:id="aboutLabel" style="-fx-text-fill: #2D3763; -fx-font-size: 14;" text="User info..." wrapText="true" />

        <Label style="-fx-text-fill: #37427c; -fx-font-size: 18; -fx-font-weight: bold;" text="Contact" />

        <VBox spacing="6">
            <HBox spacing="5">
                <Label style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;" text="Phone:" />
                <Label fx:id="phoneLabel" style="-fx-text-fill: #2D3763; -fx-font-size: 14;" text="..." />
            </HBox>

            <HBox spacing="5">
                <Label style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;" text="Email:" />
                <Label fx:id="emailLabel" style="-fx-text-fill: #2D3763; -fx-font-size: 14;" text="..." />
            </HBox>
        </VBox>
    </VBox>

