<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Client.Controllers.MainPage.ProfilePage.HistoryController"
      fx:id="historyPane"
      spacing="15"
      style="-fx-background-color: #475569; -fx-padding: 20; -fx-background-radius: 12;">

    <Label text="History"
           style="-fx-text-fill: #e2e8f0; -fx-font-size: 18; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Filter:"
               style="-fx-text-fill: #cbd5f5; -fx-font-size: 13;" />

        <ComboBox fx:id="filterBox"
                  prefWidth="150"
                  style="-fx-background-radius: 8;" />
    </HBox>

    <ListView fx:id="historyList"
              VBox.vgrow="ALWAYS"
              style="
                -fx-background-color: #334155;
                -fx-control-inner-background: #334155;
                -fx-background-radius: 10;
                -fx-border-radius: 10;
              " />

</VBox>
