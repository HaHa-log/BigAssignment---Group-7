<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.MainPage.HomePageController">
    <children>
      <HBox>
         <children>
            <Label fx:id="welcomeLabel" text="WELCOME, ">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>
        <StackPane fx:id="auctionContainer" maxHeight="500.0" maxWidth="1.7976931348623157E308" onMouseClicked="#toAuctionList" style="-fx-border-color: #37427c;-fx-cursor: hand;" VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="300.0" onMouseClicked="#toAuctionList" style="-fx-background-color: white;-fx-cursor: hand;" vbarPolicy="AS_NEEDED">
                    <content>
                        <fx:include fx:id="auctionList" source="../AuctionPageFXML/AuctionList.fxml" />
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
