<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.MainPage.HomePage.HomePageController">
    <children>
        <HBox alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" spacing="20">

            <!-- WELCOME -->
            <VBox spacing="5" HBox.hgrow="ALWAYS">

                <Label fx:id="welcomeLabel" text="WELCOME">

                    <font>
                        <Font name="System Bold" size="22" />
                    </font>

                </Label>

                <Label style="-fx-text-fill: #64748b;" text="Browse and join live auctions today." />

            </VBox>

            <!-- RIGHT -->
            <VBox alignment="TOP_RIGHT" spacing="10">

                <Button fx:id="managementNavigation" managed="false" mnemonicParsing="false" onAction="#toManagementDashboard" prefWidth="220.0" text="Management Dashboard" visible="false" />

                <fx:include source="NotificationWidget.fxml" />

            </VBox>

        </HBox>
      <StackPane fx:id="itemContainer" maxHeight="250.0" maxWidth="1.7976931348623157E308" onMouseClicked="#toInventory" style="-fx-border-color: #37427c;-fx-cursor: hand;">
         <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="300.0" onMouseClicked="#toInventory" style="-fx-background-color: white;-fx-cursor: hand;" vbarPolicy="AS_NEEDED">
               <content>
                  <fx:include fx:id="inventory" source="../../InventoryFXML/InventoryPage.fxml" />
               </content>
            </ScrollPane>
         </children>
      </StackPane>
        <StackPane fx:id="auctionContainer" maxHeight="300.0" maxWidth="1.7976931348623157E308" onMouseClicked="#toAuctionList" style="-fx-border-color: #37427c;-fx-cursor: hand;" VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="300.0" onMouseClicked="#toAuctionList" style="-fx-background-color: white;-fx-cursor: hand;" vbarPolicy="AS_NEEDED">
                    <content>
                        <fx:include fx:id="auctionList" source="../../AuctionPageFXML/AuctionList.fxml" />
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
