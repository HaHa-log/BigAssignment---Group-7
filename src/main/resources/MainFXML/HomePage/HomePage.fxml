<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.MainPage.HomePage.HomePageController">
   <children>
      <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
          <children>
              <HBox alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" spacing="20">
      
                        <!-- WELCOME -->
                  <VBox spacing="5" HBox.hgrow="ALWAYS">
      
                            <Label fx:id="welcomeLabel" text="WELCOME">
      
                                <font>
                              <Font name="System Bold" size="22" />
                          </font>
      
                            </Label>
      
                            <Label style="-fx-text-fill: #64748b;" text="Browse and join live auctions today." />
      
                        </VBox>
      
                        <!-- RIGHT -->
                  <VBox alignment="TOP_RIGHT" spacing="10">
      
                            <Button fx:id="managementNavigation" managed="false" mnemonicParsing="false" onAction="#toManagementDashboard" prefWidth="220.0" text="Management Dashboard" visible="false" />
      
                            <fx:include source="NotificationWidget.fxml" />
      
                        </VBox>
      
                    </HBox>
              <StackPane fx:id="auctionContainer" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#toAuctionList" style="-fx-border-color: #37427c;-fx-cursor: hand;" VBox.vgrow="ALWAYS">
                  <children>
                      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" minHeight="300.0" onMouseClicked="#toAuctionList" style="-fx-background-color: white;-fx-cursor: hand;" vbarPolicy="AS_NEEDED">
                          <content>
                              <fx:include fx:id="auctionList" source="../../AuctionPageFXML/AuctionList.fxml" />
                          </content>
                      </ScrollPane>
                  </children>
              </StackPane>
          </children>
          <padding>
              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
          </padding>
      </VBox>
      <StackPane fx:id="itemContainer" maxHeight="1.7976931348623157E308" maxWidth="300.0" minWidth="200.0" onMouseClicked="#toInventory" prefWidth="300.0" style="-fx-border-color: #37427c;-fx-cursor: hand;">
         <children>
            <ScrollPane hbarPolicy="ALWAYS" maxHeight="1.7976931348623157E308" minViewportWidth="200.0" onMouseClicked="#toInventory" pannable="true" prefViewportWidth="300.0" prefWidth="200.0" style="-fx-background-color: white;-fx-cursor: hand;" vbarPolicy="AS_NEEDED">
               <content>
                  <fx:include fx:id="inventory" source="../../InventoryFXML/InventoryPage.fxml" />
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </children>
</HBox>
