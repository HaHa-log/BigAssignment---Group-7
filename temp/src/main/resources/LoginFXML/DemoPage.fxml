<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="root-pane" stylesheets="@login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.Controllers.LoginPage.DemoPageController">
   <HBox alignment="CENTER_RIGHT" layoutX="300.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
          <StackPane HBox.hgrow="ALWAYS">
              <children>
                  <ImageView preserveRatio="true" fitWidth="300.0">
                      <image>
                          <Image url="@../logo.png" />
                      </image>
                  </ImageView>
              </children>
          </StackPane>
            <VBox alignment="TOP_CENTER" prefWidth="300.0" style="-fx-background-color: #37427c;">
                  <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="title" text="WELCOME" textAlignment="CENTER">
                     <VBox.margin>
                        <Insets bottom="20.0" top="40.0" />
                     </VBox.margin>
                  </Label>
      
                  <StackPane fx:id="ContentPane" maxHeight="1.7976931348623157E308" maxWidth="300.0" prefHeight="600.0" styleClass="content-area" VBox.vgrow="SOMETIMES">
                     <VBox.margin>
                        <Insets bottom="30.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </StackPane>
            </VBox>
      </children>
   </HBox>
</AnchorPane>
