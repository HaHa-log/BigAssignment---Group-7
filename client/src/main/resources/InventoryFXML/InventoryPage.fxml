<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15"
      stylesheets="@itemcard.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.Inventory.InventoryController">
    <children>
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="inventory-title" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="INVENTORY">
            <VBox.margin>
                <Insets bottom="5.0" top="15.0" />
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 20 0 20;">
            <children>
                <Label text="Filter Status:" styleClass="filter-label" />
                <ComboBox fx:id="statusFilter" prefWidth="150.0" style="-fx-background-radius: 5;" />
            </children>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS" style="-fx-padding: 0 20 10 20;">
            <children>
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-hbar-policy: NEVER; -fx-vbar-policy: NEVER;">
                    <content>
                        <FlowPane fx:id="itemList" hgap="15.0" vgap="15.0" prefWrapLength="600.0" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
                <ProgressIndicator fx:id="loadingSpinner" maxHeight="50.0" maxWidth="50.0" visible="false" />
            </children>
        </StackPane>
    </children>
</VBox>