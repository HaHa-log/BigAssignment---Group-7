<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefWidth="300.0" maxWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Inventory.ItemCardController" stylesheets="@itemcard.css" styleClass="card">
   <children>
      <StackPane style="-fx-background-color: #f1f2f6; -fx-background-radius: 6;" minWidth="100.0" minHeight="100.0">
         <children>
            <ImageView fx:id="imageContainer" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>

      <VBox spacing="4.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
         <children>
            <Label fx:id="itemNameLabel" text="Item Name" wrapText="true">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Label fx:id="statusLabel" text="STATUS: SOLD" styleClass="status-label"/>
            <Label fx:id="startingPriceLabel" text="Starting price: $0.00" />
            <Label fx:id="currentPriceLabel" text="Current price: $0.00" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>