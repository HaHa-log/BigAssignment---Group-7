<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" prefWidth="550.0" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AuctionPage.AuctionListController">
    <children>
        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="AUCTIONS" textAlignment="CENTER" wrappingWidth="219.26093292236328">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Text>
        <HBox>
            <children>
                <ComboBox fx:id="statusFilter" prefWidth="150.0" promptText="Status" />
            </children>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <TilePane fx:id="auctionTilePane" hgap="20.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefColumns="1" prefRows="0" style="-fx-border-color: #37427c;" tileAlignment="CENTER" vgap="20.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </TilePane>

                <ProgressIndicator fx:id="loadingSpinner" maxHeight="60.0" maxWidth="60.0" visible="false" />
            </children>
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </StackPane>

        <HBox alignment="CENTER" spacing="30.0">
            <children>
                <Button fx:id="btnPrev" disable="true" mnemonicParsing="false" prefWidth="120.0" text="◀ Previous" style="-fx-background-color: #37427c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnNext" disable="true" mnemonicParsing="false" prefWidth="120.0" text="Next ▶" style="-fx-background-color: #37427c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
    <padding>
        <Insets left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>