<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TableView xmlns:fx="http://javafx.com/fxml/1" fx:id="table" fx:controller="controllers.Management.AuctionManagementController" styleClass="table">
    <columns>
        <TableColumn fx:id="auctionsId" text="Auction ID" />
        <TableColumn fx:id="ownerName" text="Owner Name" />
        <TableColumn fx:id="itemName" text="Item Name" />
        <TableColumn fx:id="status" text="Status" />
        <TableColumn fx:id="startingPrice" text="Start Price" />
        <TableColumn fx:id="currentPrice" text="Current Price" />
        <TableColumn fx:id="startingTime" text="Start Time" />
        <TableColumn fx:id="endingTime" text="End Time" />
        <TableColumn fx:id="actionColumn" text="Actions" prefWidth="100.0" />
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
</TableView>
