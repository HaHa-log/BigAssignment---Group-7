<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainPage.HomePage.HomePageController">
    <children>
        <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="welcomeLabel" styleClass="label-title" text="WELCOME" />
                        <Label style="-fx-text-fill: #64748b;" text="Browse and join live auctions today." />
                    </VBox>
                    <VBox alignment="TOP_RIGHT" spacing="10">
                        <Button fx:id="managementNavigation" managed="false" mnemonicParsing="false" onAction="#toManagementDashboard" prefWidth="220.0" text="Management Dashboard" visible="false" />
                        <fx:include source="NotificationWidget.fxml" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>

                        <StackPane fx:id="auctionContainer" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#toAuctionList" style="-fx-border-color: #37427c; -fx-cursor: hand;" HBox.hgrow="ALWAYS">
                            <children>
                                <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" onMouseClicked="#toAuctionList" style="-fx-background-color: white; -fx-cursor: hand;" vbarPolicy="AS_NEEDED">
                                    <content>
                                        <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                                            <children>
                                                <fx:include fx:id="auctionList" source="../../AuctionPageFXML/AuctionList.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                            </children>
                                        </AnchorPane>
                                    </content>
                                </ScrollPane>
                            </children>
                        </StackPane>

                        <StackPane fx:id="itemContainer" maxHeight="1.7976931348623157E308" maxWidth="370.0" minWidth="320.0" onMouseClicked="#toInventory" style="-fx-background-color: #37427c; -fx-cursor: hand;" styleClass="homepage">
                            <children>
                                <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" onMouseClicked="#toInventory" pannable="true" style="-fx-background: transparent; -fx-background-color: transparent;" stylesheets="@/style.css" vbarPolicy="AS_NEEDED">
                                    <content>
                                        <AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;">
                                            <children>
                                                <fx:include fx:id="inventory" source="../../InventoryFXML/InventoryPage.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                            </children>
                                        </AnchorPane>
                                    </content>
                                </ScrollPane>
                            </children>
                        </StackPane>

                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</HBox>